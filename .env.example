# =============================================================
# KUENEERE API — орчны хувьсагчийн загвар
# Хуулж ашиглана:
#   cp .env.example .env.development   (локал хөгжүүлэлт)
#   cp .env.example .env.production    (Docker / сервер)
# Нууц түлхүүр үүсгэх:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================

# ---- Application ----
NODE_ENV=development
PORT=3003

# ---- Database (MySQL 8) ----
# Локалд (docker-compose.dev.yml-ийн mysql): DB_HOST=127.0.0.1
# Docker compose дотор: DB_HOST=mysql  (service-ийн нэр)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=kueneere
DB_PASSWORD=change_me_db_password
DB_DATABASE=kueneere_db
DB_ROOT_PASSWORD=change_me_root_password
DB_SSL=false

# ---- JWT (хамгийн багадаа 32 тэмдэгт) ----
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_32
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS: kueneree (дэлгүүр) + kueneere-admin ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Docker compose порт (зөвхөн docker-compose.yml) ----
# API_PORT=3003
# DB_EXPOSE_PORT=3306

# ---- Startup ----
RUN_MIGRATIONS_ON_BOOT=true

# ---- GraphQL (production-д false) ----
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true
GRAPHQL_DEBUG=true

# ---- Public URL / локал upload (S3 хоосон үед зураг энд хадгалагдана) ----
PUBLIC_URL=http://localhost:3003
UPLOAD_DIR=uploads

# ---- Store ----
FREE_DELIVERY_THRESHOLD=150000
DELIVERY_FEE=6000

# ---- QPay (сонголттой) ----
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=http://localhost:3003/qpay/callback

# ---- AWS S3 (сонголттой) ----
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=ap-southeast-2
AWS_S3_BUCKET=kueneere-assets-100434099419
# ---- Анхны админ (npm run seed) ----
ADMIN_EMAIL=admin@kueneere.mn
ADMIN_PASSWORD=Admin12345
